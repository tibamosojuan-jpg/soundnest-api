{
  "name": "soundnest-api",
  "version": "1.0.0",
  "description": "API REST de SoundNest, plataforma web de streaming musical",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
